# Public configuration only. Never add private keys or authenticated RPC URLs here.
# Leave empty until the deployment team provides a real Sepolia address.
VITE_CROWDFUNDING_VERSION=v1
VITE_CROWDFUNDING_ADDRESS=
VITE_CROWDFUNDING_DEPLOY_BLOCK=
# Select v2 only after deploying the current contract. Never use a V1 address here.
VITE_CROWDFUNDING_V2_ADDRESS=
VITE_CROWDFUNDING_V2_DEPLOY_BLOCK=
# Optional off-chain interactions. Publishable key only; never service-role/secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

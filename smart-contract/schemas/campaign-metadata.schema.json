{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campaign-metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "image": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(ipfs://|https://)[!-~]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "additionalDescription": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "schemaVersion",
    "image",
    "summary",
    "additionalDescription"
  ]
}
